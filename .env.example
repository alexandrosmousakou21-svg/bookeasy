VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Leave empty until a real BookEasy support inbox is configured.
VITE_BOOKEASY_SUPPORT_EMAIL=
# Public VAPID key for professional push; keep its matching private key in Supabase Edge Function secrets.
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=
# Configure WEB_PUSH_VAPID_PUBLIC_KEY, WEB_PUSH_VAPID_PRIVATE_KEY, and WEB_PUSH_VAPID_SUBJECT as Supabase Edge Function secrets only.
